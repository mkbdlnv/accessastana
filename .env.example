# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=accessastana
POSTGRES_PASSWORD=change-me
POSTGRES_DB=accessastana
DB_PORT=5432
ACCESSASTANA_DATABASE_URL=postgresql+psycopg://accessastana:change-me@localhost:5432/accessastana
ACCESSASTANA_CORS_ORIGINS=http://localhost:5173
ACCESSASTANA_LOG_LEVEL=INFO
